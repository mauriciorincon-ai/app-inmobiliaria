# Renombrar a .gitignore al estampar la app
.claude/settings.local.json
node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/
.env
.env.local
.env.*.local
*.tsbuildinfo
.vercel/
.DS_Store
Thumbs.db

# OpenNext / Cloudflare build
.open-next/
.wrangler/

# design-sync (estado de máquina; lo durable de .design-sync/ SÍ se versiona)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Copia del brochure generada por build:brochure (el canónico es docs/BROCHURE.html)
public/conoce.html

# Worker de MapLibre copiado de node_modules por build:maplibre (S6)
public/maplibre/

# Salida local de Lighthouse CI (la genera cada corrida; jamás se versiona)
.lighthouseci/

# S6 — datos crudos de Catastro Bogotá (18 MB): se descargan, no se versionan. Ver scripts/sectores/README.md.
scripts/sectores/crudo/

# S10 — manzanas crudas del valor de referencia (Catastro Bogotá): se descargan, no se versionan. Ver scripts/valor-referencia/README.md.
scripts/valor-referencia/crudo/

# S11 — la revista (páginas renderizadas, transcripción cruda y contactos) vive solo aquí, jamás versionada. Ver scripts/vivienda-nueva/README.md.
scripts/vivienda-nueva/crudo/
