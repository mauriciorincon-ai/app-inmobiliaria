{
  "name": "app-inmobiliaria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:brochure && pnpm build:maplibre && next dev",
    "build": "pnpm build:brochure && pnpm build:maplibre && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "node scripts/guarda-despliegue.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prepare": "git config core.hooksPath githooks",
    "build:brochure": "node scripts/copiar-brochure.mjs",
    "build:maplibre": "node scripts/copiar-maplibre.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "aws4fetch": "^1.0.20",
    "browser-image-compression": "^2.0.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "pino": "^10.4.0",
    "posthog-js": "^1.438.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  }
}
